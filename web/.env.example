# Firebase Web App Configuration (Never commit a populated .env with private keys)
# Copy this file to .env and fill in values from Firebase Console -> Project Settings -> Your Apps -> Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=ai-studio-android-myfamily-31bcdd9d-0dee-46fe-8aa9-4f2cc590f319

# Set to true only for local Firebase Emulator development
VITE_USE_FIREBASE_EMULATORS=false
